{
    "name": "kursa",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "dev": "pnpm db:migrate && turbo dev",
        "build": "turbo build",
        "check-types": "turbo check-types",
        "dev:web": "turbo -F web dev",
        "dev:server": "turbo -F server dev",
        "db:push": "turbo -F @kursa/db db:push",
        "db:studio": "turbo -F @kursa/db db:studio",
        "db:generate": "turbo -F @kursa/db db:generate",
        "db:migrate": "turbo -F @kursa/db db:migrate"
    },
    "dependencies": {
        "@kursa/env": "workspace:*",
        "dotenv": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@kursa/config": "workspace:*",
        "@types/node": "^22.13.14",
        "turbo": "^2.8.12",
        "typescript": "catalog:"
    },
    "packageManager": "pnpm@10.12.1"
}