# Copy to apps/server/.env — see docs/intelligence/MARKET_APIS.md for market keys

NEXT_PUBLIC_SERVER_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-min-32-characters-long-secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=
OPENAI_API_KEY=

# Market intelligence (enabled by default; set MARKET_ENABLED=false to disable)
MARKET_ENABLED=true

# Recommended: one free USDOL registration for US jobs + wages
# https://www.careeronestop.org/Developers/WebAPI/registration.aspx
CAREERONESTOP_USER_ID=
CAREERONESTOP_API_TOKEN=

# Optional providers
BLS_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ONET_USERNAME=
ONET_PASSWORD=

# Remote OK + Arbeitnow work with no keys (job listings only)
