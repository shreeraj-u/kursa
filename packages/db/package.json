{
    "name": "@kursa/db",
    "type": "module",
    "exports": {
        ".": {
            "default": "./src/index.ts"
        },
        "./*": {
            "default": "./src/*.ts"
        }
    },
    "scripts": {
        "db:push": "prisma db push",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "postinstall": "prisma generate",
        "db:studio": "prisma studio",
        "seed:dashboard": "SEED_SCENARIO=dashboard pnpm prisma db seed",
        "seed:ai-observation": "SEED_SCENARIO=ai-observation pnpm prisma db seed",
        "seed:tester2": "SEED_SCENARIO=tester2 pnpm prisma db seed"
    },
    "dependencies": {
        "@better-auth/utils": "^0.4.0",
        "@kursa/env": "workspace:*",
        "@neondatabase/serverless": "^1.0.2",
        "@prisma/adapter-neon": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "dotenv": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@kursa/config": "workspace:*",
        "prisma": "^7.8.0",
        "tsx": "^4.22.3",
        "typescript": "catalog:"
    },
    "prisma": {
        "seed": "tsx --env-file=../../apps/server/.env prisma/seed.ts"
    }
}